{
  "name": "ai-ticket-it",
  "version": "1.0.0",
  "private": true,
  "description": "Plataforma de publicación de eventos y venta de entradas - TP individual Desarrollo con IA (DDS UTN FRBA 2C 2026)",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start:backend": "npm start --workspace=backend",
    "dev:backend": "npm run dev --workspace=backend",
    "start:mobile": "npm start --workspace=mobile",
    "start:dev": "concurrently \"npm run dev:backend\" \"npm run start:mobile\"",
    "test": "npm test --workspace=backend",
    "lint": "eslint .",
    "format": "prettier . --write",
    "typecheck": "npm run typecheck --workspace=mobile"
  },
  "author": "Santino Lazzari",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.31.0",
    "globals": "^16.3.0",
    "prettier": "3.6.2"
  }
}
